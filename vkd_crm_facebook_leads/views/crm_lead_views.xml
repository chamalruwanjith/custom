<odoo>
    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit.vkd_crm_facebook_leads</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr='//page[@name="lead"]' position='after'>
                <page name="categorization" string="Facebook Info">
                    <group name="facebook_info" string="Facebook Info">
                        <field name="facebook_lead_id"/>
                        <field name="facebook_date_create"/>
                        <field name="facebook_page_id"/>
                        <field name="facebook_form_id"/>
                        <field name="facebook_adset_id"/>
                        <field name="facebook_ad_id"/>
                        <field name="facebook_campaign_id"/>
                        <field name="facebook_is_organic"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//label[@for='date_deadline']" position='before'>
                <field name="lead_allocate_id" invisible="1"/>
            </xpath>
            <!-- Extra Information customization in CRM lead-->
            <xpath expr="//page[@name='lead']/group/group[3]/field[@name='medium_id']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[3]/field[@name='source_id']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[3]/field[@name='referred']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[3]/field[@name='campaign_id']" position='before'>
                <field name="lead_id"/>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[3]/field[@name='campaign_id']" position='after'>
                <field name="purpose"/>
                <field name="adset_name"/>
                <field name="property_type"/>
                <field name="budget"/>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group/field[@name='partner_name']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group/label[@for='street_page_lead']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group/div[@class='o_address_format']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group/field[@name='website']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[4]/field[@name='company_id']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[4]/field[@name='team_id']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[4]/field[@name='team_id']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[4]/field[@name='day_open']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[4]/field[@name='day_close']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[4]" position='inside'>
                <field name="best_contact_time"/>
                <field name="desired_number_of_perches"/>
                <field name="job_title"/>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[2]/label[@for='contact_name_page_lead']"
                   position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[2]/div[@class='o_row']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[2]/field[@name='function']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[2]/label[@for='mobile_page_lead']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[2]/div" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr='//field[@name="lost_reason_id"]' position='before'>
                <label for="whatsapp_number" class="oe_inline"/>
                <div class="o_row o_row_readonly">
                    <button name="phone_action_blacklist_remove" class="fa fa-ban text-danger"
                            title="This phone number is blacklisted for SMS Marketing. Click to unblacklist."
                            type="object" context="{'default_phone': phone}" groups="base.group_user"
                            invisible="not phone_blacklisted"/>
                    <field name="whatsapp_number" widget="phone"/>
                    <span class="fa fa-exclamation-triangle text-warning oe_edit_only"
                          title="By saving this change, the customer phone number will also be updated."
                          invisible="not partner_phone_update"/>
                </div>
                <label for="additional_phone_number" class="oe_inline"/>
                <div class="o_row o_row_readonly">
                    <button name="phone_action_blacklist_remove" class="fa fa-ban text-danger"
                            title="This phone number is blacklisted for SMS Marketing. Click to unblacklist."
                            type="object" context="{'default_phone': phone}" groups="base.group_user"
                            invisible="not phone_blacklisted"/>
                    <field name="additional_phone_number" widget="phone"/>
                    <span class="fa fa-exclamation-triangle text-warning oe_edit_only"
                          title="By saving this change, the customer phone number will also be updated."
                          invisible="not partner_phone_update"/>
                </div>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position='after'>
                <field name="full_name"/>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group" position='replace'/>
            <xpath expr="//page[@name='lead']/group/group[@class='mt48']" position='replace'/>

            <xpath expr="//page[@name='internal_notes']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//div[@class='oe_title']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='lead_priority']/field[@name='tag_ids']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position='attributes'>
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
