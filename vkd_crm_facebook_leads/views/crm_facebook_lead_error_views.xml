<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_facebook_lead_error_tree" model="ir.ui.view">
        <field name="name">crm.facebook.lead.error.view.tree</field>
        <field name="model">crm.facebook.lead.error</field>
        <field name="arch" type="xml">
            <tree string="Lead Import Errors" decoration-danger="True"
                  create="0" edit="0" delete="1">
                <field name="create_date" string="Failed At"/>
                <field name="form_id"/>
                <field name="facebook_lead_id"/>
                <field name="adset_name"/>
                <field name="error"/>
            </tree>
        </field>
    </record>

    <record id="view_crm_facebook_lead_error_form" model="ir.ui.view">
        <field name="name">crm.facebook.lead.error.view.form</field>
        <field name="model">crm.facebook.lead.error</field>
        <field name="arch" type="xml">
            <form string="Lead Import Error" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" string="Failed At"/>
                            <field name="form_id"/>
                            <field name="facebook_lead_id"/>
                            <field name="adset_name"/>
                        </group>
                    </group>
                    <group string="Error Details">
                        <field name="error" nolabel="1"/>
                    </group>
                    <group string="Lead Data">
                        <field name="lead_data" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_crm_facebook_lead_error" model="ir.actions.act_window">
        <field name="name">Lead Import Errors</field>
        <field name="res_model">crm.facebook.lead.error</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_crm_facebook_lead_error"
        name="Lead Import Errors"
        parent="crm.menu_crm_config_lead"
        sequence="102"
        action="action_crm_facebook_lead_error"
        groups="sales_team.group_sale_manager"/>
</odoo>
