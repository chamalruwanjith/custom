<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <!-- IHM Agent details list view -->
    <record id="ihm_agent_view_tree" model="ir.ui.view">
        <field name="name">ihm.agent.view.tree</field>
        <field name="model">ihm.agent</field>
        <field name="arch" type="xml">
            <tree string="IHM Agent Details">
                <field name="ihm_agent_name"/>
                <field name="ihm_agent_description"/>
            </tree>
        </field>
    </record>

    <!-- IHM Agent details form view -->
    <record id="ihm_agent_view_form" model="ir.ui.view">
        <field name="name">ihm.agent.view.tree</field>
        <field name="model">ihm.agent</field>
        <field name="arch" type="xml">
            <form string="IHM Agent Details">
                <sheet>
                    <group>
                        <field name="ihm_agent_name"/>
                        <field name="ihm_agent_description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for IHM Agent Details -->
    <record id="ihm_agent_details_action" model="ir.actions.act_window">
        <field name="name">IHM Agent Details</field>
        <field name="res_model">ihm.agent</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_ihm_agent_details"
              name="IHM Agents"
              parent="menu_sale_agent"
              action="ihm_agent_details_action"
              sequence="3"
              groups="group_property_management_manager"/>

</odoo>