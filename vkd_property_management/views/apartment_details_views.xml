<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- KANBAN VIEW (NEW) -->
    <record id="view_apartment_details_kanban" model="ir.ui.view">
        <field name="name">apartment.details.view.kanban</field>
        <field name="model">apartment.details</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="id"/>
                <field name="apartment_name"/>
                <field name="apartment_image"/>
                <field name="apartment_type"/>
                <field name="city"/>
                <field name="is_publish"/>
                <field name="is_multiple_towers"/>
                <field name="is_include_villas"/>
                <field name="total_units_count"/>
                <field name="sold_percent"/>
                <field name="available_percent"/>
                <field name="reserved_percent"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_image_fill_left d-none d-md-block"
                                 t-attf-style="background-image:url('#{kanban_image('apartment.details', 'apartment_image', record.id.raw_value)}'); background-size: cover; background-position: center;">
                            </div>

                            <div class="oe_kanban_details d-flex flex-column">

                                <div class="o_kanban_record_top mb-1">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title" style="font-size: 16px;">
                                            <field name="apartment_name"/>
                                        </strong>
                                    </div>
                                    <span class="badge rounded-pill text-bg-primary">
                                        <field name="apartment_type"/>
                                    </span>
                                </div>

                                <div class="o_kanban_record_body">
                                    <div t-if="record.city and record.city.raw_value" class="text-muted mb-2">
                                        <i class="fa fa-map-marker me-1" title="Location" aria-label="Location"/> <field name="city"/>
                                    </div>

                                    <div>
                                        <span t-if="record.is_multiple_towers and record.is_multiple_towers.raw_value" class="badge text-bg-light border me-1" title="Multi-Tower">
                                            <i class="fa fa-building-o"/> Towers
                                        </span>
                                        <span t-if="record.is_include_villas and record.is_include_villas.raw_value" class="badge text-bg-light border" title="Includes Villas">
                                            <i class="fa fa-home"/> Villas
                                        </span>
                                    </div>

                                    <div class="o_kanban_record_bottom mt-auto pt-2">
                                        <div class="oe_kanban_bottom_left">
                                            <span t-attf-class="badge #{record.is_publish.raw_value ? 'text-bg-success' : 'text-bg-secondary'}">
                                                <t t-if="record.is_publish.raw_value">Active</t>
                                                <t t-else="">Inactive</t>
                                            </span>
                                        </div>
                                    </div>

                                    <div class="mt-3 text-muted" style="font-size: 12px;">
                                        <strong><t t-esc="record.total_units_count ? record.total_units_count.raw_value : 0"/></strong> Total Units
                                    </div>

                                    <div class="progress mt-1" style="height: 8px; border-radius: 4px;" t-if="record.total_units_count and record.total_units_count.raw_value > 0">
                                        <div class="progress-bar bg-success" role="progressbar"
                                             t-attf-style="width: #{record.sold_percent ? record.sold_percent.raw_value : 0}%;"
                                             t-att-title="'Sold: ' + Math.round(record.sold_percent ? record.sold_percent.raw_value : 0) + '%'"/>
                                        <div class="progress-bar bg-warning" role="progressbar"
                                             t-attf-style="width: #{record.reserved_percent ? record.reserved_percent.raw_value : 0}%;"
                                             t-att-title="'Reserved/Hold: ' + Math.round(record.reserved_percent ? record.reserved_percent.raw_value : 0) + '%'"/>
                                        <div class="progress-bar bg-info" role="progressbar"
                                             t-attf-style="width: #{record.available_percent ? record.available_percent.raw_value : 0}%;"
                                             t-att-title="'Available: ' + Math.round(record.available_percent ? record.available_percent.raw_value : 0) + '%'"/>
                                    </div>
                                    <div t-else="" class="mt-1 text-muted" style="font-size: 12px; font-style: italic;">
                                        No units added yet
                                    </div>
                                </div>

                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- TREE VIEW -->
    <record id="view_apartment_details_tree" model="ir.ui.view">
        <field name="name">apartment.details.view.tree</field>
        <field name="model">apartment.details</field>
        <field name="arch" type="xml">
            <tree string="Apartment Details">
                <field name="apartment_name"/>
                <field name="apartment_prefix"/>
                <field name="apartment_type"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_apartment_details_form" model="ir.ui.view">
        <field name="name">apartment.details.view.form</field>
        <field name="model">apartment.details</field>
        <field name="arch" type="xml">
            <form string="Apartment Details">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_apartment_units)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-cubes"
                                invisible="total_units_count == 0">
                            <field name="total_units_count" widget="statinfo" string="Units"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="apartment_name"/>
                            <field name="apartment_prefix"/>
                            <field name="is_multiple_towers"/>
                            <field name="is_include_villas"/>
                            <field name="prefix_for_villas" invisible="is_include_villas == False"/>
                            <field name="apartment_type" widget="radio"/>
                            <field name="company_id" invisible="1"/>
                            <label for="address_line_1" string="Apartment Address"/>
                            <div class="o_address_format">
                                <field name="address_line_1" placeholder="Street..." class="o_address_street"/>
                                <field name="address_line_2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="zip_code" placeholder="ZIP" class="o_address_zip"/>
                            </div>
                            <field name="is_publish"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="apartment_image" nolabel="1" widget='image' class="oe_avatar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Towers" invisible="is_multiple_towers == False">
                            <field name="tower_details_ids" widget="one2many"/>
                        </page>
                        <page string="Floors">
                            <field name="floor_details_ids" widget="one2many"/>
                        </page>
                        <page string="Units">
                            <field name="unit_details_ids" widget="one2many"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_apartment_details" model="ir.actions.act_window">
        <field name="name">Apartment Details</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">apartment.details</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <menuitem id="menu_apartment_details"
              name="Apartments"
              parent="menu_apartment_management"
              action="action_apartment_details"
              sequence="1"/>

</odoo>