<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_unit_reservation_tree" model="ir.ui.view">
        <field name="name">unit.reservation.view.tree</field>
        <field name="model">unit.reservation</field>
        <field name="arch" type="xml">
            <tree string="Unit Reservations">
                <field name="reservation_id"/>
                <field name="sale_agent_id"/>
                <field name="apartment_details_id"/>
                <field name="floor_details_id"/>
                <field name="unit_details_id"/>
                <field name="reservation_status" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_unit_reservation_form" model="ir.ui.view">
        <field name="name">unit.reservation.view.form</field>
        <field name="model">unit.reservation</field>
        <field name="arch" type="xml">
            <form string="Unit Reservation">
                <header>
                    <button name="action_unit_hold" type="object" string="Hold" class="oe_highlight"
                            invisible="reservation_status in ['hold', 'reserved', 'sold', 'cancel']"/>
                    <button name="action_unit_reserve" type="object" string="Tentatively Sold" class="oe_highlight"
                            invisible="reservation_status in ['reserved', 'cancel', 'draft', 'sold']"/>
                    <button name="action_set_cancel" type="object" string="Cancel" class="oe_highlight"
                            invisible="reservation_status in ['cancel', 'draft']"/>
                    <button name="action_set_reset" type="object" string="Reset to Draft" class="oe_highlight"
                            invisible="reservation_status in ['reset', 'hold', 'reserved', 'sold', 'draft', 'expired']"/>
                    <field name="reservation_status" widget='statusbar'
                           statusbar_visible="draft,hold,reserved,sold,expired,cancel"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_sale_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-signal"
                                string="Sales"
                                invisible="sale_order_count == 0">
                            <field name="sale_order_count" widget="statinfo" string="Sale Orders"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="reservation_id" readonly="reservation_status != 'draft'"/>
                            <field name="sale_agent_id" readonly="reservation_status != 'draft'"/>
                            <field name="apartment_details_id" domain="[('is_active', '=', True)]"
                                   readonly="reservation_status != 'draft'"/>
                            <field name="floor_details_id"
                                   domain="[('apartment_details_id', '=', apartment_details_id)]"
                                   readonly="reservation_status != 'draft'"/>
                            <field name="unit_details_id"
                                   domain="[('unit_status', '=', 'available'), ('floor_details_id', '=', floor_details_id)]"
                                   readonly="reservation_status != 'draft'"/>
                        </group>
                        <group>
                            <field name="reserved_date"/>
                            <field name="expiration_date"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sales" invisible="reservation_status in ['reset', 'draft', 'expired']">
                            <group>
                                <group string="Customer">
                                    <field name="partner_id" readonly="reservation_status != 'hold'"/>
                                    <field name="is_existing_customer" readonly="reservation_status != 'hold'"/>
                                    <field name="existing_apartment_id" readonly="reservation_status != 'hold'"
                                           invisible="is_existing_customer == False"/>
                                    <field name="existing_unit_id" readonly="reservation_status != 'hold'"
                                           invisible="is_existing_customer == False"
                                           domain="[('apartment_details_id', '=', existing_apartment_id)]"/>
                                    <field name="first_contact_number" readonly="reservation_status != 'hold'"/>
                                    <field name="second_contact_number" readonly="reservation_status != 'hold'"/>
                                    <field name="whatsapp_number" readonly="reservation_status != 'hold'"/>
                                    <field name="source_of_sale" readonly="reservation_status != 'hold'"/>
                                    <field name="other_source_of_sale" readonly="reservation_status != 'hold'"
                                           invisible="source_of_sale != 'other'"/>
                                </group>
                                <group string="Pricing">
                                    <field name="discounted_price" readonly="reservation_status != 'hold'"/>
                                    <field name="paid_amount" readonly="reservation_status != 'hold'"/>
                                    <field name="is_million_completion" readonly="reservation_status != 'hold'"/>
                                    <field name="is_ceiling_rate_applicable" readonly="reservation_status != 'hold'"/>
                                </group>
                                <group string="Sales">
                                    <field name="first_sale_agent_id" readonly="reservation_status != 'hold'"/>
                                    <field name="second_sale_agent_id" readonly="reservation_status != 'hold'"/>
                                    <field name="ihm_agent" readonly="reservation_status != 'hold'"/>
                                    <field name="assist_by" readonly="reservation_status != 'hold'"/>
                                    <field name="crm_team_id" readonly="reservation_status != 'hold'"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_unit_reservation" model="ir.actions.act_window">
        <field name="name">Unit Reservation</field>
        <field name="res_model">unit.reservation</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('reservation_status', '=', ('draft', 'hold', 'expired', 'cancel'))]</field>
    </record>

    <record id="action_tentatively_sold" model="ir.actions.act_window">
        <field name="name">Unit Reservation</field>
        <field name="res_model">unit.reservation</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('reservation_status', '=', 'reserved')]</field>
    </record>

    <record id="action_unit_sold" model="ir.actions.act_window">
        <field name="name">Unit Reservation</field>
        <field name="res_model">unit.reservation</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('reservation_status', '=', 'sold')]</field>
    </record>

    <menuitem id="menu_unit_reservation"
              name="Unit Holds"
              parent="menu_unit_management"
              action="action_unit_reservation"
              sequence="2"/>

    <menuitem id="menu_unit_tentatively_sold"
              name="Tentatively Sold"
              parent="menu_unit_management"
              action="action_tentatively_sold"
              sequence="3"/>

    <menuitem id="menu_unit_sold"
              name="Unit Sold"
              parent="menu_unit_management"
              action="action_unit_sold"
              sequence="4"/>

</odoo>