<odoo>
    <record id="crm_lead_project_view_tree" model="ir.ui.view">
        <field name="name">crm.lead.project.view.tree</field>
        <field name="model">crm.lead.project</field>
        <field name="arch" type="xml">
            <tree string="Projects" editable="bottom">
                <field name="name"/>
                <field name="active" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="action_crm_lead_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">crm.lead.project</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem
        id="menu_crm_lead_project"
        name="Projects"
        parent="crm.menu_crm_config_lead"
        sequence="7"
        action="action_crm_lead_project"
        groups="sales_team.group_sale_manager"/>
</odoo>