<odoo>
    <record id="lead_allocate_view_form" model="ir.ui.view">
        <field name="name">lead.allocate.view.form</field>
        <field name="model">lead.allocate</field>
        <field name="arch" type="xml">
            <form string="Lead Allocate">
                <sheet>
                    <group>
                        <group string="Assignment">
                            <field name="team_id"/>
                            <field name="allocation_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="distribution_type"/>
                        </group>
                        <group string="Schedule">
                            <field name="shift_date"/>
                            <field name="shift_id"/>
                            <field name="from_time" readonly="1"/>
                            <field name="to_time" readonly="1"/>
                        </group>
                    </group>

                    <group invisible="distribution_type != 'single'">
                        <field name="user_id" string="Agent"/>
                    </group>

                    <notebook>
                        <page string="Agents ( In round-robin order )"
                              invisible="distribution_type != 'round_robin'">
                            <field name="allocate_line_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="user_id"/>
                                    <field name="lead_count"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="lead_allocate_view_tree" model="ir.ui.view">
        <field name="name">lead.allocate.view.tree</field>
        <field name="model">lead.allocate</field>
        <field name="arch" type="xml">
            <tree>
                <field name="team_id"/>
                <field name="allocation_type"/>
                <field name="shift_id"/>
                <field name="distribution_type"/>
                <field name="user_id" optional="show"/>
                <field name="shift_date"/>
                <field name="from_time"/>
                <field name="to_time"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="action_lead_allocate_views" model="ir.actions.act_window">
        <field name="name">Lead Allocate</field>
        <field name="res_model">lead.allocate</field>
        <field name="view_mode">tree,form</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="lead_allocate_view_tree"/>
    </record>

    <record id="lead_allocate_view_search_filter" model="ir.ui.view">
        <field name="name">lead.allocate.search.filter</field>
        <field name="model">lead.allocate</field>
        <field name="arch" type="xml">
            <search string="Lead Allocate">
                <field name="team_id"/>
                <field name="allocation_type"/>
                <field name="user_id"/>
                <field name="shift_id"/>
                <field name="shift_date"/>
                <separator/>
                <filter string="Apartment" name="type_apartment" domain="[('allocation_type','=','apartment')]"/>
                <filter string="Lands" name="type_lands" domain="[('allocation_type','=','lands')]"/>
                <separator/>
                <filter string="Single Agent" name="single" domain="[('distribution_type','=','single')]"/>
                <filter string="Round Robin" name="round_robin" domain="[('distribution_type','=','round_robin')]"/>
                <group expand="0" string="Group By">
                    <filter string="Team" name="group_team" context="{'group_by': 'team_id'}"/>
                    <filter string="Allocation Type" name="group_alloc_type" context="{'group_by': 'allocation_type'}"/>
                    <filter string="Shift" name="group_shift" context="{'group_by': 'shift_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'shift_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem
            id="menu_crm_lead_allocate"
            name="Leads Allocate"
            parent="crm.menu_crm_config_lead"
            sequence="4"
            action="action_lead_allocate_views"
            groups="vkd_lead_manage.group_lead_allocation"/>
</odoo>
