<odoo>
    <record id="crm_lead_branch_view_tree" model="ir.ui.view">
        <field name="name">crm.lead.branch.view.tree</field>
        <field name="model">crm.lead.branch</field>
        <field name="arch" type="xml">
            <tree string="Branches" editable="bottom">
                <field name="name"/>
                <field name="description"/>
                <field name="active" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="action_crm_lead_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">crm.lead.branch</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem
        id="menu_crm_lead_branch"
        name="Branches"
        parent="crm.menu_crm_config_lead"
        sequence="6"
        action="action_crm_lead_branch"
        groups="sales_team.group_sale_manager"/>
</odoo>