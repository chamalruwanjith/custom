<odoo>
    <record id="module_category_lead_management" model="ir.module.category">
        <field name="name">Lead Management</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_lead_allocation" model="res.groups">
        <field name="name">Lead Allocation</field>
        <field name="category_id" ref="module_category_lead_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Sales managers automatically get Lead Allocation rights -->
    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('vkd_lead_manage.group_lead_allocation'))]"/>
    </record>
</odoo>